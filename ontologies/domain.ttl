
@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Person a owl:Class .

ex:Employee a owl:Class ;
  rdfs:subClassOf ex:Person , [
    a owl:Restriction ;
    owl:onProperty ex:worksFor ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 ;
    owl:allValuesFrom ex:Company
  ] .

ex:Contractor a owl:Class ;
  rdfs:subClassOf ex:Person .

# Disjointness between Employee and Contractor
ex:Employee owl:disjointWith ex:Contractor .

ex:Company a owl:Class .

# Datatype property for names
ex:name a owl:DatatypeProperty ;
  rdfs:domain ex:Person ;
  rdfs:range xsd:string .

# Object property worksFor
ex:worksFor a owl:ObjectProperty ;
  rdfs:domain ex:Employee ;
  rdfs:range ex:Company .

# Requirement class
ex:Requirement a owl:Class .

# Requirement is disjoint with all other classes
ex:Requirement owl:disjointWith ex:Person, ex:Employee, ex:Contractor, ex:Company .

# derivedReq object property (Requirement -> Requirement, parent direction)
ex:derivedReq a owl:ObjectProperty ;
  rdfs:domain ex:Requirement ;
  rdfs:range ex:Requirement ;
  rdfs:label "derivedReq" ;
  rdfs:comment "Points to the parent requirement from a derived requirement. At most 1 parent." .

# Requirement attributes
ex:text a owl:DatatypeProperty ;
  rdfs:domain ex:Requirement ;
  rdfs:range xsd:string .

ex:Id a owl:DatatypeProperty ;
  rdfs:domain ex:Requirement ;
  rdfs:range xsd:string .

# ConceptualElement class
ex:ConceptualElement a owl:Class .

# ConceptualElement is disjoint with all other classes
ex:ConceptualElement owl:disjointWith ex:Person, ex:Employee, ex:Contractor, ex:Company, ex:Requirement .

# association object property (ConceptualElement -> ConceptualElement, parent direction)
ex:association a owl:ObjectProperty ;
  rdfs:domain ex:ConceptualElement ;
  rdfs:range ex:ConceptualElement ;
  rdfs:label "association" ;
  rdfs:comment "Points to the parent ConceptualElement. At most 1 parent." .

# ConceptualElement attribute
ex:Name a owl:DatatypeProperty ;
  rdfs:domain ex:ConceptualElement ;
  rdfs:range xsd:string .
